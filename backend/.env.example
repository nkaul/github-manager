APP_ENV=local
APP_ORIGIN=http://127.0.0.1:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SCOPES=read:user repo read:org notifications
GITHUB_API_VERSION=2026-03-10
SESSION_TTL_SECONDS=3600
# Show a reminder before the local session expires; renewal is explicit, never automatic.
SESSION_WARNING_SECONDS=120
# Total bound for a background GitHub Sync; each GitHub request also has its own timeout.
GITHUB_SYNC_TIMEOUT_SECONDS=300
OAUTH_STATE_TTL_SECONDS=600
REPORTS_DIRECTORY=../docs/validation/private
# GITHUB_FIXTURES_FILE=github-fixtures.local.json

# Phase 0.5 approved local harness: provisional models; live API calls disabled by default.
# Add the key only to ignored backend/.env. Never expose it to the frontend.
OPENAI_API_KEY=
OPENAI_TAXONOMY_MODEL=gpt-6.1-sol
OPENAI_CLASSIFICATION_MODEL=gpt-6-luna
OPENAI_TAXONOMY_COMPARISON_MODEL=gpt-6-astra
OPENAI_CLASSIFICATION_COMPARISON_MODEL=gpt-6.1-sol
OPENAI_TAXONOMY_REASONING_EFFORT=low
OPENAI_CLASSIFICATION_REASONING_EFFORT=low
AI_PRETEST_LIVE_ENABLED=false
AI_PRETEST_ALLOWED_DATA=public_and_synthetic
AI_PRETEST_BUDGET_USD=5.00
AI_PRETEST_PERSISTENCE=sqlite
AI_PRETEST_STATE_DIRECTORY=../docs/validation/private/ai-pretest
AI_PRETEST_CLASSIFICATION_MAX_INPUT_TOKENS=2000
AI_PRETEST_CLASSIFICATION_MAX_OUTPUT_TOKENS=2048
AI_PRETEST_TAXONOMY_MAX_INPUT_TOKENS=12000
AI_PRETEST_TAXONOMY_MAX_OUTPUT_TOKENS=4096
AI_PRETEST_REQUEST_TIMEOUT_SECONDS=60
AI_PRETEST_MAX_RETRIES=1
AI_PRETEST_MAX_GENERATION_CALLS=34
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false

# Phase 0.9 local app: separate state and an audited, renewable API allowance.
DEMO_DATABASE=../docs/validation/private/demo/app.sqlite3
DEMO_LIVE_AI=false
# Use scripts/dev-demo.sh --live-ai for explicit live mode within the approved allowance.
# Numeric GitHub user IDs allowed to manage the shared allowance in the local UI.
# Leave blank to disable web-based allowance changes; CLI remains available locally.
DEMO_BUDGET_OPERATOR_IDS=
# Renew/select limits through AI Organization > Manage API allowance, or:
# cd backend && .venv/bin/python -m app.demo.manage_allowance renew --requests 20 --reason "Local testing"
# This changes request/generation admission only, preserving the cumulative $5 ceiling.
