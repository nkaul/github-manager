    "evidence": [
      {
        "id": "E0",
        "section": "GITHUB_METADATA",
        "text": "fastapi. FastAPI framework, high performance, easy to learn, fast to code, ready for production Topics: api, async, asyncio, fastapi, framework, json, json-schema, openapi, openapi3, pydantic, python, python-types. Language: Python"
      },
      {
        "id": "E1",
        "section": "TITLE",
        "text": "Documentation : https://fastapi.tiangolo.com"
      },
      {
        "id": "E2",
        "section": "TITLE",
        "text": "Source Code : https://github.com/fastapi/fastapi"
      },
      {
        "id": "E3",
        "section": "TITLE",
        "text": "FastAPI is a modern, fast (high-performance), web framework for building APIs with Python based on standard Python type hints."
      },
      {
        "id": "E4",
        "section": "TITLE",
        "text": "The key features are:"
      },
      {
        "id": "E5",
        "section": "TITLE",
        "text": "Fast : Very high performance, on par with NodeJS and Go (thanks to Starlette and Pydantic). One of the fastest Python frameworks available ."
      },
      {
        "id": "E6",
        "section": "TITLE",
        "text": "Fast to code : Increase the speed to develop features by about 200% to 300%. *"
      },
      {
        "id": "E7",
        "section": "TITLE",
        "text": "Fewer bugs : Reduce about 40% of human (developer) induced errors. *"
      },
      {
        "id": "E8",
        "section": "TITLE",
        "text": "Intuitive : Great editor support. Completion everywhere. Less time debugging."
      },
      {
        "id": "E9",
        "section": "TITLE",
        "text": "Easy : Designed to be easy to use and learn. Less time reading docs."
      },
      {
        "id": "E10",
        "section": "TITLE",
        "text": "Short : Minimize code duplication. Multiple features from each parameter declaration. Fewer bugs."
      },
      {
        "id": "E11",
        "section": "TITLE",
        "text": "Robust : Get production-ready code. With automatic interactive documentation."
      },
      {
        "id": "E12",
        "section": "TITLE",
        "text": "Standards-based : Based on (and fully compatible with) the open standards for APIs: OpenAPI (previously known as Swagger) and JSON Schema ."
      },
      {
        "id": "E13",
        "section": "TITLE",
        "text": "* estimation based on tests conducted by an internal development team, building production applications."
      },
      {
        "id": "E14",
        "section": "about fastapi cloud",
        "text": "About FastAPI Cloud"
      },
      {
        "id": "E15",
        "section": "about fastapi cloud",
        "text": "FastAPI Cloud is built by the same author and team behind FastAPI ."
      },
      {
        "id": "E16",
        "section": "about fastapi cloud",
        "text": "It streamlines the process of building , deploying , and accessing an API with minimal effort."
      },
      {
        "id": "E17",
        "section": "about fastapi cloud",
        "text": "It brings the same developer experience of building apps with FastAPI to deploying them to the cloud. 🎉"
      },
      {
        "id": "E18",
        "section": "about fastapi cloud",
        "text": "FastAPI Cloud is the primary sponsor and funding provider for the FastAPI and friends open source projects. ✨"
      }
    ],
