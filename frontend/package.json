{
  "name": "github-manager-frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:pretest": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:corpus": "playwright test --config playwright.corpus.config.ts",
    "test:regression": "playwright test --config playwright.regression.config.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "typescript": "5.9.3"
  }
}
