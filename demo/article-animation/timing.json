  "segments": [
    {
      "id": "discover",
      "heading": "Your repositories deserve a map.",
      "text": "Your own repositories. Shared projects. Libraries you starred for later. Finding them is easy. Remembering how they fit together is harder. GitHub Manager brings them into one workspace, where you can search, explore, and organize.",
      "sources": [
        "README.md",
        "ai-system-design/publication/v2/article.md#opening"
      ],
      "cues": {
        "Shared projects": 3.040000057220459,
        "GitHub Manager": 10.94000015258789,
        "search": 13.94000015258789
      },
      "start": 0,
      "end": 16.602,
      "audio_start": 0.6,
      "audio_end": 15.93
    },
    {
      "id": "organize",
      "heading": "Same technology. Different purpose.",
      "text": "Projects group an initiative. Domains group those projects. Topics describe capabilities, and tags describe technologies. Two repositories can both use Python without belonging to the same project.",
      "sources": [
        "ai-system-design/publication/v2/article.md#give-the-organization-a-vocabulary-people-can-understand"
      ],
      "cues": {
        "Domains": 19.6819994468689,
        "Topics": 21.621999980926518,
        "Two repositories": 26.042000057220463
      },
      "start": 16.602,
      "end": 30.432000000000002,
      "audio_start": 16.852,
      "audio_end": 30.122
    },
    {
      "id": "taxonomy",
      "heading": "Agree on the vocabulary first.",
      "text": "There are two separate AI jobs. Taxonomy discovery proposes a vocabulary from a collection of repositories. You review and edit it. Classification then works with approved concepts, rather than inventing new labels.",
      "sources": [
        "ai-system-design/publication/v2/article.md#first-ask-the-model-to-propose-a-useful-vocabulary"
      ],
      "cues": {
        "proposes": 34.68199809265137,
        "You review": 38.401999313354494,
        "Classification": 40.16200144958496
      },
      "start": 30.432000000000002,
      "end": 45.472,
      "audio_start": 30.682000000000002,
      "audio_end": 45.162000000000006
    },
    {
      "id": "evidence",
      "heading": "Keep the sentence that explains why.",
      "text": "Follow our synthetic Orion example. Its README says: patient intake API for the Orion Clinical Platform. Uses FastAPI and Python. We keep that purpose sentence, its evidence reference, and useful phrases.",
      "sources": [
        "ai-system-design/publication/v2/examples/orion-api.json"
      ],
      "cues": {
        "patient intake": 50.1820009918213,
        "Uses FastAPI": 53.40199839782716,
        "purpose sentence": 57.30199992370606
      },
      "start": 45.472,
      "end": 61.504000000000005,
      "audio_start": 45.722,
      "audio_end": 61.082
    },
    {
      "id": "retrieve",
      "heading": "A shortlist is not a decision.",
      "text": "Local search retrieves six possible concepts. Some are distractions: Forge shares the word platform, but that doesn't establish a relationship. Retrieval finds possibilities. It doesn't assign them.",
      "sources": [
        "ai-system-design/publication/v2/examples/orion-api.json"
      ],
      "cues": {
        "six": 63.03400068664551,
        "Forge": 66.45399885559083,
        "doesn't assign": 72.69399671936037
      },
      "start": 61.504000000000005,
      "end": 74.16,
      "audio_start": 61.754000000000005,
      "audio_end": 73.79400000000001
    },
    {
      "id": "classify",
      "heading": "Show the model evidence and boundaries.",
      "text": "The model receives evidence, candidate definitions, instructions, and a response schema. In the saved test, it selected Orion, Web APIs, FastAPI, and Python, citing the purpose sentence. You review those suggestions before accepting them.",
      "sources": [
        "ai-system-design/publication/v2/examples/orion-api.json"
      ],
      "cues": {
        "response schema": 78.6500016784668,
        "selected Orion": 81.44999710083007,
        "citing": 86.84999862670898,
        "You review": 88.2699967956543
      },
      "start": 74.16,
      "end": 91.702,
      "audio_start": 74.41,
      "audio_end": 91.28
    },
    {
      "id": "remember",
      "heading": "Remember the work. Respect your decisions.",
      "text": "The app remembers completed analysis separately from labels. Removing a project doesn't erase that receipt. Later changes can reconcile locally. A fresh AI analysis remains an explicit choice.",
      "sources": [
        "ai-system-design/publication/v2/article.md#remember-completed-analysis-when-the-organization-changes"
      ],
      "cues": {
        "Removing": 96.04200015258789,
