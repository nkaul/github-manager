  "segments": [
    {
      "id": "intro",
      "text": "GitHub Manager brings your repositories into one clear workspace, with a calmer interface and a little zen.",
      "first_word": 0,
      "last_word": 16,
      "spoken_start": 0,
      "spoken_end": 7.260000228881836,
      "start": 0.0,
      "end": 8.6614,
      "audio_start": 0.3085,
      "raw_start": 0,
      "audio_seconds": 7.78
    },
    {
      "id": "browse",
      "text": "Use the sidebar to browse projects, topics, and tags.",
      "first_word": 17,
      "last_word": 25,
      "spoken_start": 8.300000190734863,
      "spoken_end": 11.699999809265137,
      "start": 8.6614,
      "end": 14.3257,
      "audio_start": 9.0199,
      "raw_start": 7.78000020980835,
      "audio_seconds": 4.64
    },
    {
      "id": "search",
      "text": "Search and filters help you narrow the list.",
      "first_word": 26,
      "last_word": 33,
      "spoken_start": 13.140000343322754,
      "spoken_end": 15.0600004196167,
      "start": 14.3257,
      "end": 18.7907,
      "audio_start": 14.7757,
      "raw_start": 12.420000076293945,
      "audio_seconds": 2.99
    },
    {
      "id": "metrics",
      "text": "The compact cards show what is labeled, what still needs a project, and which repositories you've selected.",
      "first_word": 34,
      "last_word": 50,
      "spoken_start": 15.760000228881836,
      "spoken_end": 21.399999618530273,
      "start": 18.7907,
      "end": 26.3714,
      "audio_start": 19.169,
      "raw_start": 15.410000324249268,
      "audio_seconds": 6.5
    },
    {
      "id": "ai",
      "text": "AI Organization lets you preview a repository batch and its budget, then review taxonomy and classification suggestions. Approve suggestions to apply them.",
      "first_word": 51,
      "last_word": 72,
      "spoken_start": 22.420000076293945,
      "spoken_end": 32.279998779296875,
      "start": 26.3714,
      "end": 38.3057,
      "audio_start": 26.7264,
      "raw_start": 21.90999984741211,
      "audio_seconds": 10.92
    },
    {
      "id": "protected",
      "text": "Already analyzed repositories stay protected from repeated AI calls. You can explicitly re-analyze when something important changes.",
      "first_word": 73,
      "last_word": 89,
      "spoken_start": 33.380001068115234,
      "spoken_end": 41.0,
      "start": 38.3057,
      "end": 48.07,
      "audio_start": 38.6607,
      "raw_start": 32.829999923706055,
      "audio_seconds": 8.75
    },
    {
      "id": "manual",
      "text": "Keep control with manual assignments, drag and drop, and local rules.",
      "first_word": 90,
      "last_word": 100,
      "spoken_start": 42.15999984741211,
      "spoken_end": 46.060001373291016,
      "start": 48.07,
      "end": 54.535,
      "audio_start": 48.52,
      "raw_start": 41.579999923706055,
      "audio_seconds": 4.83
    },
    {
      "id": "appearance",
      "text": "In Appearance, choose your favorite zen cat.",
      "first_word": 101,
      "last_word": 105,
      "spoken_start": 46.7599983215332,
      "spoken_end": 48.65999984741211,
