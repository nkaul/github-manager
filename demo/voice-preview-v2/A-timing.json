  "segments": [
    {
      "id": "intro",
      "text": "GitHub Manager brings your repositories into one clear workspace, with a calmer interface and a little zen.",
      "first_word": 0,
      "last_word": 16,
      "spoken_start": 0,
      "spoken_end": 6.159999847412109,
      "start": 0.0,
      "end": 7.8566,
      "audio_start": 0.4433,
      "raw_start": 0,
      "audio_seconds": 6.59
    },
    {
      "id": "browse",
      "text": "Use the sidebar to browse projects, topics, and tags.",
      "first_word": 17,
      "last_word": 25,
      "spoken_start": 7.019999980926514,
      "spoken_end": 9.920000076293945,
      "start": 7.8566,
      "end": 14.0023,
      "audio_start": 8.3066,
      "raw_start": 6.5899999141693115,
      "audio_seconds": 3.79
    },
    {
      "id": "search",
      "text": "Search and filters help you narrow the list.",
      "first_word": 26,
      "last_word": 33,
      "spoken_start": 10.84000015258789,
      "spoken_end": 12.600000381469727,
      "start": 14.0023,
      "end": 18.8043,
      "audio_start": 14.4523,
      "raw_start": 10.380000114440918,
      "audio_seconds": 2.59
    },
    {
      "id": "metrics",
      "text": "The compact cards show what is labeled, what still needs a project, and which repositories you've selected.",
      "first_word": 34,
      "last_word": 49,
      "spoken_start": 13.34000015258789,
      "spoken_end": 18.5,
      "start": 18.8043,
      "end": 26.2846,
      "audio_start": 19.2543,
      "raw_start": 12.970000267028809,
      "audio_seconds": 5.87
    },
    {
      "id": "ai",
      "text": "AI Organization lets you preview a repository batch and its budget, then review taxonomy and classification suggestions. Approve suggestions to apply them.",
      "first_word": 50,
      "last_word": 71,
      "spoken_start": 19.18000030517578,
      "spoken_end": 28.700000762939453,
      "start": 26.2846,
      "end": 37.6403,
      "audio_start": 26.7346,
      "raw_start": 18.84000015258789,
      "audio_seconds": 9.86
    },
    {
      "id": "protected",
      "text": "Already analyzed repositories stay protected from repeated AI calls. You can explicitly re-analyze when something important changes.",
      "first_word": 72,
      "last_word": 88,
      "spoken_start": 28.700000762939453,
      "spoken_end": 36.52000045776367,
      "start": 37.6403,
      "end": 47.396,
      "audio_start": 38.0903,
      "raw_start": 28.700000762939453,
      "audio_seconds": 8.26
    },
    {
      "id": "manual",
      "text": "Keep control with manual assignments, drag and drop, and local rules.",
      "first_word": 89,
      "last_word": 99,
      "spoken_start": 37.400001525878906,
      "spoken_end": 40.900001525878906,
      "start": 47.396,
      "end": 54.198,
      "audio_start": 47.846,
      "raw_start": 36.96000099182129,
      "audio_seconds": 4.14
    },
    {
      "id": "appearance",
      "text": "In Appearance, choose your favorite zen cat.",
      "first_word": 100,
      "last_word": 106,
      "spoken_start": 41.29999923706055,
      "spoken_end": 43.63999938964844,
      "start": 54.198,
