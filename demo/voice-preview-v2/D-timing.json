  "segments": [
    {
      "id": "intro",
      "text": "GitHub Manager brings your repositories into one clear workspace, with a calmer interface and a little zen.",
      "first_word": 0,
      "last_word": 16,
      "spoken_start": 0,
      "spoken_end": 6.045498474121096,
      "start": 0.0,
      "end": 7.7426,
      "audio_start": 0.45,
      "raw_start": 0,
      "audio_seconds": 6.4355
    },
    {
      "id": "browse",
      "text": "Use the sidebar to browse projects, topics, and tags.",
      "first_word": 17,
      "last_word": 25,
      "spoken_start": 6.825501068115237,
      "spoken_end": 9.825501068115237,
      "start": 7.7426,
      "end": 13.9389,
      "audio_start": 8.1926,
      "raw_start": 6.435499771118167,
      "audio_seconds": 3.85
    },
    {
      "id": "search",
      "text": "Search and filters help you narrow the list.",
      "first_word": 26,
      "last_word": 33,
      "spoken_start": 10.74549923706055,
      "spoken_end": 12.42549954223633,
      "start": 13.9389,
      "end": 18.7764,
      "audio_start": 14.3889,
      "raw_start": 10.285500152587893,
      "audio_seconds": 2.5
    },
    {
      "id": "metrics",
      "text": "The compact cards show what is labeled, what still needs a project, and which repositories you've selected.",
      "first_word": 34,
      "last_word": 50,
      "spoken_start": 13.14549694824219,
      "spoken_end": 18.665501220703128,
      "start": 18.7764,
      "end": 26.6524,
      "audio_start": 19.2264,
      "raw_start": 12.78549824523926,
      "audio_seconds": 6.21
    },
    {
      "id": "ai",
      "text": "AI Organization lets you preview a repository batch and its budget, then review taxonomy and classification suggestions. Approve suggestions to apply them.",
      "first_word": 51,
      "last_word": 72,
      "spoken_start": 19.32549725341797,
      "spoken_end": 28.605503662109378,
      "start": 26.6524,
      "end": 38.1287,
      "audio_start": 27.1024,
      "raw_start": 18.99549923706055,
      "audio_seconds": 9.93
    },
    {
      "id": "protected",
      "text": "Already analyzed repositories stay protected from repeated AI calls. You can explicitly re-analyze when something important changes.",
      "first_word": 73,
      "last_word": 89,
      "spoken_start": 29.245503051757815,
      "spoken_end": 36.00549755859375,
      "start": 38.1287,
      "end": 47.3251,
      "audio_start": 38.5787,
      "raw_start": 28.925503356933596,
      "audio_seconds": 7.49
    },
    {
      "id": "manual",
      "text": "Keep control with manual assignments, drag and drop, and local rules.",
      "first_word": 90,
      "last_word": 100,
      "spoken_start": 36.82549725341797,
      "spoken_end": 40.485500915527346,
      "start": 47.3251,
      "end": 54.1625,
      "audio_start": 47.7751,
      "raw_start": 36.41549740600586,
      "audio_seconds": 4.390833333333333
    },
