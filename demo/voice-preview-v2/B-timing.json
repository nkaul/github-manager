  "segments": [
    {
      "id": "intro",
      "text": "GitHub Manager brings your repositories into one clear workspace, with a calmer interface and a little zen.",
      "first_word": 0,
      "last_word": 16,
      "spoken_start": 0.17000045776367045,
      "spoken_end": 5.710001373291014,
      "start": 0.0,
      "end": 7.3877,
      "audio_start": 0.45,
      "raw_start": 0.05000045776367046,
      "audio_seconds": 6.0
    },
    {
      "id": "browse",
      "text": "Use the sidebar to browse projects, topics, and tags.",
      "first_word": 17,
      "last_word": 25,
      "spoken_start": 6.3900016784667955,
      "spoken_end": 9.17000045776367,
      "start": 7.3877,
      "end": 13.6849,
      "audio_start": 7.8377,
      "raw_start": 6.050001525878905,
      "audio_seconds": 3.55
    },
    {
      "id": "search",
      "text": "Search and filters help you narrow the list.",
      "first_word": 26,
      "last_word": 33,
      "spoken_start": 10.030001068115233,
      "spoken_end": 11.589998626708983,
      "start": 13.6849,
      "end": 18.5929,
      "audio_start": 14.1349,
      "raw_start": 9.600000762939452,
      "audio_seconds": 2.18
    },
    {
      "id": "metrics",
      "text": "The compact cards show what is labeled, what still needs a project, and which repositories you've selected.",
      "first_word": 34,
      "last_word": 50,
      "spoken_start": 11.969999694824217,
      "spoken_end": 17.65,
      "start": 18.5929,
      "end": 26.5897,
      "audio_start": 19.0429,
      "raw_start": 11.7799991607666,
      "audio_seconds": 6.22
    },
    {
      "id": "ai",
      "text": "AI Organization lets you preview a repository batch and its budget, then review taxonomy and classification suggestions. Approve suggestions to apply them.",
      "first_word": 51,
      "last_word": 72,
      "spoken_start": 18.349996948242186,
      "spoken_end": 26.609999084472655,
      "start": 26.5897,
      "end": 37.8869,
      "audio_start": 27.0397,
      "raw_start": 17.999998474121092,
      "audio_seconds": 8.98
    },
    {
      "id": "protected",
      "text": "Already analyzed repositories stay protected from repeated AI calls. You can explicitly re-analyze when something important changes.",
      "first_word": 73,
      "last_word": 89,
      "spoken_start": 27.349996948242186,
      "spoken_end": 33.96999969482422,
      "start": 37.8869,
      "end": 47.184,
      "audio_start": 38.3369,
      "raw_start": 26.97999801635742,
      "audio_seconds": 7.38
    },
    {
      "id": "manual",
      "text": "Keep control with manual assignments, drag and drop, and local rules.",
      "first_word": 90,
      "last_word": 100,
      "spoken_start": 34.74999847412109,
      "spoken_end": 38.15,
      "start": 47.184,
      "end": 54.092,
      "audio_start": 47.634,
      "raw_start": 34.359999084472655,
      "audio_seconds": 4.025
    },
    {
      "id": "appearance",
      "text": "In Appearance, choose your favorite zen cat.",
      "first_word": 101,
      "last_word": 101,
      "spoken_start": 38.62,
      "spoken_end": 41.67066666666667,
